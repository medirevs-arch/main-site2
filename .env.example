# Copy to .env.local and fill in.

# Required. The Google Apps Script web-app URL that receives form submissions.
# Without it the site refuses submissions with an honest 503 rather than
# pretending to have saved them.
MEDIREVS_FORMS_ENDPOINT=

# Optional but recommended now that the waitlist is the primary call to action.
# Tried only after the sheet has failed every retry. Any URL accepting a JSON
# POST works: a second Apps Script, a Zapier or Make hook, a Slack webhook.
MEDIREVS_FORMS_BACKUP_ENDPOINT=
